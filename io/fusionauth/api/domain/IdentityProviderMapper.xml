  <sql id="select">
    SELECT
      idp.id                          AS idp_id,
      idp.tenants_id                  AS idp_tenants_id,
      idp.data                        AS idp_data,
      idp.enabled                     AS idp_enabled,
      idp.name                        AS idp_name,
      idp.insert_instant              AS idp_insert_instant,
      idp.last_update_instant         AS idp_last_update_instant,
      idp.keys_id                     AS idp_keys_id,
      idp.reconcile_lambdas_id        AS idp_reconcile_lambdas_id,
      idp.request_signing_keys_id     AS idp_request_signing_keys_id,
      idp.source                      AS idp_source,
      idp.type                                                                 AS idp_type,
      CASE WHEN ipvk.type = 'ExternalJwtVerification' THEN ipvk.keys_id END    AS idp_external_jwt_verification_keys_id,
      CASE WHEN ipvk.type = 'Samlv2ResponseVerification' THEN ipvk.keys_id END AS idp_samlv2_verification_keys_id
    FROM identity_providers AS idp
           LEFT OUTER JOIN identity_providers_verification_keys AS ipvk
    ON idp.id = ipvk.identity_providers_id
  </sql>

  <sql id="selectApplicationIdentityConfigurations">
    SELECT
      idp_app.identity_providers_id AS idp_app_identity_providers_id,
      idp_app.applications_id       AS idp_app_applications_id,
      idp_app.data                  AS idp_app_data,
      idp_app.enabled               AS idp_app_enabled,
      idp_app.keys_id               AS idp_app_keys_id
    FROM identity_providers_applications AS idp_app
  </sql>

  <sql id="selectTenantIdentityConfigurations">
    SELECT
      idp_tenant.identity_providers_id      AS idp_tenant_identity_providers_id,
      idp_tenant.tenants_id                 AS idp_tenant_tenants_id,
      idp_tenant.data                       AS idp_tenant_data
      FROM identity_providers_tenants AS idp_tenant
  </sql>

  <insert id="create">
    INSERT INTO identity_providers
    <choose>
      <when test="type.name().equals('Apple')">
        (id, tenants_id, data, enabled, name, keys_id, reconcile_lambdas_id, source, type, insert_instant, last_update_instant) VALUES (#{id}, #{tenantId}, #{dataToDatabase}, #{enabled}, #{name}, #{keyId}, #{lambdaConfiguration.reconcileId}, #{source}, #{type}, #{insertInstant}, #{lastUpdateInstant})
      </when>
      <when test="type.name().equals('SAMLv2')">
        (id, tenants_id, data, enabled, name, keys_id, reconcile_lambdas_id, request_signing_keys_id, source, type, insert_instant, last_update_instant) VALUES (#{id}, #{tenantId}, #{dataToDatabase}, #{enabled}, #{name}, #{keyId}, #{lambdaConfiguration.reconcileId}, #{requestSigningKeyId}, #{source}, #{type}, #{insertInstant}, #{lastUpdateInstant})
      </when>
      <when test="type.name().equals('SAMLv2IdPInitiated')">
        (id, tenants_id, data, enabled, name, keys_id, reconcile_lambdas_id, source, type, insert_instant, last_update_instant) VALUES (#{id}, #{tenantId}, #{dataToDatabase}, #{enabled}, #{name}, #{keyId}, #{lambdaConfiguration.reconcileId}, #{source}, #{type}, #{insertInstant}, #{lastUpdateInstant})
      </when>
      <when test="type.name().equals('ExternalJWT')">
        (id, tenants_id, data, enabled, name, keys_id, reconcile_lambdas_id, source, type, insert_instant, last_update_instant) VALUES (#{id}, #{tenantId}, #{dataToDatabase}, #{enabled}, #{name}, #{defaultKeyId}, #{lambdaConfiguration.reconcileId}, #{source}, #{type}, #{insertInstant}, #{lastUpdateInstant})
      </when>
      <otherwise>
        (id, tenants_id, data, enabled, name, reconcile_lambdas_id, source, type, insert_instant, last_update_instant) VALUES (#{id}, #{tenantId}, #{dataToDatabase}, #{enabled}, #{name}, #{lambdaConfiguration.reconcileId}, #{source}, #{type}, #{insertInstant}, #{lastUpdateInstant})
      </otherwise>
    </choose>
  </insert>

  <update id="update">
    UPDATE identity_providers SET
    data = #{dataToDatabase},
    enabled = #{enabled},
    name = #{name},
    last_update_instant = #{lastUpdateInstant},
    <if test="type.name().equals('Apple') or type.name().equals('SAMLv2') or type.name().equals('SAMLv2IdPInitiated')">
      keys_id = #{keyId},
    </if>
    <if test="type.name().equals('ExternalJWT')">
      keys_id = #{defaultKeyId},
    </if>
    <if test="type.name().equals('SAMLv2')">
      request_signing_keys_id = #{requestSigningKeyId},
    </if>
    reconcile_lambdas_id = #{lambdaConfiguration.reconcileId}
    WHERE id = #{id}
  </update>

  <insert id="createFederatedDomains">
    INSERT INTO federated_domains (identity_providers_id, domain, tenants_id) VALUES
    <foreach collection="domains" item="domain" separator=",">
      (#{id}, #{domain}, #{tenantId})
    </foreach>
  </insert>

  <insert id="createApplicationConfiguration">
    INSERT INTO identity_providers_applications (applications_id, identity_providers_id, data, enabled
    <if test="type.name().equals('Apple')">
      , keys_id
    </if>
    ) VALUES
    <foreach collection="applicationConfigurations" index="applicationId" item="config" separator=",">
      (#{applicationId}, #{id}, #{config.dataToDatabase}, #{config.enabled}
      <if test="type.name().equals('Apple')">
        , #{config.keyId}
      </if>
      )
    </foreach>
  </insert>

  <insert id="createTenantConfiguration">
    INSERT INTO identity_providers_tenants (tenants_id, identity_providers_id, data) VALUES
    <foreach collection="tenantConfigurations" index="tenantId" item="config" separator=",">
      (#{tenantId}, #{id}, #{config.dataToDatabase})
    </foreach>
  </insert>

  <insert id="createVerificationKeys">
    INSERT INTO identity_providers_verification_keys (identity_providers_id, keys_id, type, is_default) VALUES
    <foreach collection="keyIds" item="keyId" index="i" separator=",">
      (#{identityProviderId}, #{keyId}, #{type}, ${i == 0})
    </foreach>
  </insert>

  <select id="retrieveAll" resultMap="IdentityProvider">
    <include refid="select"/>
    <if test="tenantId != null">
      WHERE idp.tenants_id = #{tenantId}
    </if>
    ORDER BY idp.insert_instant DESC, idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
  </select>

  <select id="retrieveByCriteria" resultMap="IdentityProvider">
    WITH ids AS (
    SELECT idp.id
    FROM identity_providers idp
    <where>
      <if test="name != null">
        AND LOWER(idp.name) LIKE #{name}
      </if>
      <if test="source != null">
        AND LOWER(idp.source) LIKE #{source}
      </if>
      <if test="tenantId != null">
        AND idp.tenants_id = #{tenantId}
      </if>
      <if test="type != null">
        AND idp.type LIKE #{type}
      </if>
      <if test="applicationId != null">
        AND EXISTS (
        SELECT 1
        FROM identity_providers_applications a
        WHERE a.identity_providers_id = idp.id
        AND a.applications_id = #{applicationId}
        AND enabled = TRUE
        )
      </if>
    </where>
    <if test="orderBy != null">
      ORDER BY ${orderBy}
    </if>
    <if test="numberOfResults != null">
      LIMIT #{numberOfResults}
    </if>
    <if test="startRow != null">
      OFFSET #{startRow}
    </if>
    )
    <include refid="select"/>
    INNER JOIN ids ON ids.id = idp.id
    <choose>
      <when test="orderBy != null">
        ORDER BY ${orderBy}, idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
      </when>
      <otherwise>
        ORDER BY idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
      </otherwise>
    </choose>
  </select>

  <select id="retrieveById" resultMap="IdentityProvider">
    <include refid="select"/>
    WHERE idp.id = #{id}
    <if test="tenantId != null">
      AND idp.tenants_id = #{tenantId}
    </if>
    ORDER BY idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
  </select>

  <select id="retrieveByIdForUpdate" resultMap="IdentityProvider">
    <!--
      Intentionally does NOT include the verification-key LEFT JOIN from the "select" fragment. This is a
      lock-and-reload SELECT ... FOR UPDATE; Postgres does not permit FOR UPDATE against the nullable side of an outer
      join (it would error or lock unintended rows), and Tenant has no FOR-UPDATE-with-join precedent to copy. The
      verification keys are not needed to take the row lock and are loaded by the subsequent read query.

      The two CASE-aliased verification-key columns are still selected as NULL literals so the shared "IdentityProvider"
      resultMap can resolve its verificationKeyIds collection (its notNullColumn references these columns by name).
      Selecting them as NULL keeps the collection empty here without the fan-out join.
    -->
    SELECT
    idp.id AS idp_id,
    idp.tenants_id AS idp_tenants_id,
    idp.data AS idp_data,
    idp.enabled AS idp_enabled,
    idp.name AS idp_name,
    idp.insert_instant AS idp_insert_instant,
    idp.last_update_instant AS idp_last_update_instant,
    idp.keys_id AS idp_keys_id,
    idp.reconcile_lambdas_id AS idp_reconcile_lambdas_id,
    idp.request_signing_keys_id AS idp_request_signing_keys_id,
    idp.source AS idp_source,
    idp.type AS idp_type,
    NULL AS idp_external_jwt_verification_keys_id,
    NULL AS idp_samlv2_verification_keys_id
    FROM identity_providers AS idp
    WHERE idp.id = #{id}
    <if test="tenantId != null">
      AND idp.tenants_id = #{tenantId}
    </if>
    <if test="existingLastUpdateInstant != null">
      AND idp.last_update_instant = #{existingLastUpdateInstant}
    </if>
      FOR UPDATE
  </select>

  <select id="retrieveByName" resultMap="IdentityProvider">
    <include refid="select"/>
    WHERE idp.name = #{name}
    <choose>
      <when test="tenantId != null">
        AND idp.tenants_id = #{tenantId}
      </when>
      <otherwise>
        <!-- Only consider "tenants_id IS NULL" if tenantId was not provided. -->
        <!-- This provides global IdPs with their own unique pool of names during validation. -->
        AND idp.tenants_id IS NULL
      </otherwise>
    </choose>
    ORDER BY idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
  </select>

  <select id="retrieveCountByCriteria" resultType="int">
    SELECT COUNT(*)
    FROM identity_providers idp
    <where>
      <if test="name != null">
        AND LOWER(idp.name) LIKE #{name}
      </if>
      <if test="source != null">
        AND LOWER(idp.source) LIKE #{source}
      </if>
      <if test="tenantId != null">
        AND idp.tenants_id = #{tenantId}
      </if>
      <if test="type != null">
        AND idp.type LIKE #{type}
      </if>
      <if test="applicationId != null">
        AND EXISTS (
          SELECT 1
          FROM identity_providers_applications a
          WHERE a.identity_providers_id = idp.id
            AND a.applications_id = #{applicationId}
            AND enabled = TRUE
        )
      </if>
    </where>
  </select>

  <select id="retrieveExisting" resultMap="IdentityProvider">
    <include refid="select"/>
    <!-- Search for other IdPs with the given name to avoid name collisions on update -->
    WHERE idp.id != #{id}
        AND idp.name = #{name}
    <choose>
      <when test="tenantId != null">
        AND idp.tenants_id = #{tenantId}
      </when>
      <otherwise>
        <!-- Only consider "tenants_id IS NULL" if tenantId was not provided. -->
        <!-- This provides global IdPs with their own unique pool of names during validation. -->
        AND idp.tenants_id IS NULL
      </otherwise>
    </choose>
    ORDER BY idp.id, ipvk.type, ipvk.is_default DESC, ipvk.keys_id
  </select>

