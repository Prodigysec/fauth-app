  <select id="retrieveExistingDomains" resultType="java.lang.String">
    SELECT domain from federated_domains AS fd
    WHERE
      fd.domain IN (
      <foreach collection="domains" item="domain" separator=",">
        #{domain}
      </foreach>
      )
    <if test="id != null">
