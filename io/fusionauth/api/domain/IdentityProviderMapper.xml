  <resultMap id="_ExternalJWTIdentityProvider" type="io.fusionauth.api.domain.mybatis._ExternalJWTIdentityProvider" extends="IdentityProvider">
    <result property="defaultKeyId" column="idp_keys_id"/>
    <!--
      Verification key ids are loaded via the single LEFT JOIN on identity_providers_verification_keys in the "select"
      sql fragment (mirroring Tenant/Application), not a separate per-IdP select. The joined keys_id column is
      partitioned by type using a CASE-aliased column plus notNullColumn, so only ExternalJwtVerification rows
      contribute here. Because the primary IdP row also fans out across the joined verification-key rows, the nested
      <id> dedupes repeats so each key appears once. Read queries order the joined rows by
      "ipvk.type, ipvk.is_default DESC, ipvk.keys_id" so the default key is the first element of the list.
    -->
    <collection property="verificationKeyIds" ofType="java.util.UUID" notNullColumn="idp_external_jwt_verification_keys_id">
      <id column="idp_external_jwt_verification_keys_id"/>
      <result column="idp_external_jwt_verification_keys_id"/>
    </collection>
    <collection property="configurations" column="idp_id" fetchType="eager" select="retrieveExternalApplicationConfigurations"/>
    <collection property="domains" column="idp_id" fetchType="eager" select="retrieveDomains"/>
    <collection property="tenantConfigurations" column="idp_id" fetchType="eager" select="retrieveTenantConfigurations"/>
  </resultMap>

  <resultMap id="_FacebookIdentityProvider" type="io.fusionauth.api.domain.mybatis._FacebookIdentityProvider" extends="IdentityProvider">
